{
	"name": "@dualsubs/spotify",
	"organizationName": "🍿️ DualSubs",
	"displayName": "🍿️ DualSubs: 🎵 Spotify",
	"description": "Spotify 增强及双语歌词",
	"homepage": "https://DualSubs.github.io/guide/spotify",
	"openUrl": "https://dualsubs.github.io/settings/#Spotify",
	"icon": "https://github.com/DualSubs/Spotify/raw/main/src/assets/icon_rounded.png",
	"keywords": [],
	"contributors": [
		"VirgilClyne[https://github.com/VirgilClyne]"
	],
	"system": [
		"iOS",
		"iPadOS",
		"macOS"
	],
	"systemVersion": 15,
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/DualSubs/Spotify.git"
	},
	"directories": {
		"example": "example"
	},
	"scripts": {
		"serve": "webpack serve",
		"build": "rspack build",
		"build:dev": "rspack build -c rspack.dev.config.js --mode=development",
		"build:args": "arguments-builder build && node scripts/prepare-preference-panes.mjs",
		"build:dev-args": "arguments-builder build -c arguments-builder.dev.config.ts && node scripts/prepare-preference-panes.mjs --dev",
		"dts": "arguments-builder dts",
		"submodule": "git submodule update --remote",
		"test": "node --test tests/*.test.mjs"
	},
	"browserslist": [
		"iOS >= 15"
	],
	"devDependencies": {
		"@iringo/arguments-builder": "^1.8.5",
		"@protobuf-ts/plugin": "^2.11.1",
		"@rspack/cli": "^1.5.8",
		"@rspack/core": "^1.5.8",
		"node-polyfill-webpack-plugin": "^4.1.0"
	},
	"dependencies": {
		"@nsnanocat/util": "^1.8.10",
		"@protobuf-ts/runtime": "^2.11.1"
	}
}
