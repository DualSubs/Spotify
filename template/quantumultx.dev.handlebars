#!name = {{@package 'displayName'}}
#!desc = {{inline (@package 'description')}}
#!openUrl = {{@package 'openUrl'}}
#!author = {{@package 'contributors'}}
#!homepage = {{@package 'homepage'}}
#!icon = {{@package 'icon'}}
#!category = {{@package 'organizationName'}}
#!date = {{now "yyyy-MM-dd HH:mm:ss"}}
#!version = dev

#[rewrite_local]
^https:\/\/dualsubs\.github\.io\/api\/Spotify(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: dev echo-response https://gist.githubusercontent.com/VirgilClyne/e60d056221d3d42ef6fa30c4e3ea8a51/raw/DualSubs.Spotify.dev.PreferencePanes.json
# 🍿️ DualSubs.Spotify.Tracks.response
^https?:\/\/api\.spotify\.com\/v1\/tracks\? url script-response-body https://gist.githubusercontent.com/VirgilClyne/e60d056221d3d42ef6fa30c4e3ea8a51/raw/response.bundle.js

# 🍿️ DualSubs.Spotify.Lyrics.request
^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*) url script-request-body https://gist.githubusercontent.com/VirgilClyne/e60d056221d3d42ef6fa30c4e3ea8a51/raw/request.bundle.js

# 🍿️ DualSubs.Spotify.Translate.Lyrics.response
^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=Translate url script-response-body https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js

# 🍿️ DualSubs.Spotify.External.Lyrics.response
^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=External url script-response-body https://github.com/DualSubs/Universal/releases/latest/download/External.Lyrics.response.bundle.js

#[mitm]
hostname = dualsubs.github.io, api.spotify.com, spclient.wg.spotify.com, *-spclient.spotify.com
