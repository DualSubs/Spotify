name: "{{@package 'displayName'}}"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{version}}"

http:
  mitm:
    - "dualsubs.github.io"
    - "api.spotify.com"
    - "spclient.wg.spotify.com"
    - "*-spclient.spotify.com"
  script:
    - match: ^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$
      name: PreferencePanes.API
      type: request
      require-body: true
      max-size: 65536
    - match: ^https:\/\/dualsubs\.github\.io\/api\/Spotify(?:\?.*)?$
      name: 📺 DualSubs.Spotify.Config
      type: request
      require-body: false
    - match: ^https?:\/\/api\.spotify\.com\/v1\/tracks\?
      name: 🍿️ DualSubs.Spotify.response
      type: response
      require-body: true

    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json
      name: 🍿️ DualSubs.Spotify.request
      type: request
      require-body: true
    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)
      name: 🍿️ DualSubs.Spotify.request
      type: request
      require-body: true
      binary-mode: true

    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate
      name: 🍿️ DualSubs.Translate.Lyrics.response
      type: response
      require-body: true
    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate
      name: 🍿️ DualSubs.Translate.Lyrics.response
      type: response
      require-body: true
      binary-mode: true

    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External
      name: 🍿️ DualSubs.External.Lyrics.response
      type: response
      require-body: true
    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External
      name: 🍿️ DualSubs.External.Lyrics.response
      type: response
      require-body: true
      binary-mode: true

script-providers:
  PreferencePanes.API:
    url: https://github.com/NSNanoCat/PreferencePanes/releases/download/v1.3.1/api.js
    interval: 86400
  📺 DualSubs.Spotify.Config:
    url: https://gist.githubusercontent.com/VirgilClyne/e60d056221d3d42ef6fa30c4e3ea8a51/raw/config.dev.bundle.js
    interval: 86400
  🍿️ DualSubs.Spotify.request:
    url: https://gist.githubusercontent.com/VirgilClyne/e60d056221d3d42ef6fa30c4e3ea8a51/raw/request.dev.bundle.js
    interval: 86400
  🍿️ DualSubs.Spotify.response:
    url: https://gist.githubusercontent.com/VirgilClyne/e60d056221d3d42ef6fa30c4e3ea8a51/raw/response.dev.bundle.js
    interval: 86400
  🍿️ DualSubs.Translate.Lyrics.response:
    url: https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.dev.bundle.js
    interval: 86400
  🍿️ DualSubs.External.Lyrics.response:
    url: https://github.com/DualSubs/Universal/releases/latest/download/External.Lyrics.response.dev.bundle.js
    interval: 86400
